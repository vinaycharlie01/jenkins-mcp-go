# Copy to .env (git-ignored) and fill in. Never commit real values.

JENKINS_URL=https://jenkins.example.com
# All job paths are relative to this folder (e.g. Team or Team/sub). Empty = Jenkins root.
JENKINS_BASE_FOLDER=

# cookie (your browser SSO session, local use) or api-token
JENKINS_AUTH_MODE=cookie
# Session cookie name as shown in DevTools; the suffix differs per Jenkins instance.
JENKINS_COOKIE_NAME=JSESSIONID.xxxxxxxx
# Your own session cookie value.
JENKINS_SESSION=
# Alternative: a file holding the cookie value, re-read on every request (rotate without restart).
# JENKINS_SESSION_FILE=/path/to/jenkins-session

# api-token mode (your own token: Jenkins -> your user -> Security -> API Token)
# JENKINS_USER=
# JENKINS_API_TOKEN=
# JENKINS_API_TOKEN_FILE=

# Optional: how your pipeline prints pushed images, if not docker push/buildx/kaniko/jib.
# Go regex with named groups image (required), tag, digest.
# JENKINS_IMAGE_PATTERN=PUBLISHED (?P<image>\S+) (?P<digest>sha256:[0-9a-f]{64})

# JENKINS_CA_FILE=
# JENKINS_INSECURE=false
# JENKINS_REQUEST_TIMEOUT=30s

LOG_LEVEL=info
LOG_FORMAT=json
